    fun addPersonLedgerEntry(
        personId: Long,
        amount: Long,
        relation: SplitRelation,
        note: String,
        occurredAt: Long = System.currentTimeMillis()
    ): Long {
        if (amount <= 0) return -1
        val signed = if (relation == SplitRelation.OWES_ME) amount else -amount
        val cv = ContentValues().apply {
            put("person_id", personId)
            put("amount_signed", signed)
            put("occurred_at", occurredAt)
            put("note", note.trim().ifBlank { if (relation == SplitRelation.OWES_ME) "طلب" else "بدهی" })
            putNull("transaction_id")
        }
        return dbHelper.writableDatabase.insert("person_ledger", null, cv)
    }

    fun settlePerson(personId: Long, amount: Long, theyPaidMe: Boolean, note: String = "تسویه") {
        if (amount <= 0) return
        val signed = if (theyPaidMe) -amount else amount
        val cv = ContentValues().apply {
            put("person_id", personId)
            put("amount_signed", signed)
            put("occurred_at", System.currentTimeMillis())
            put("note", note.trim().ifBlank { "تسویه" })
            putNull("transaction_id")
        }
        dbHelper.writableDatabase.insert("person_ledger", null, cv)
    }

