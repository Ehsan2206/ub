                }
                Spacer(Modifier.height(12.dp))
                Button(
                    onClick={
                        onSave(
                            transaction.copy(
                                amount=Money.parse(amount),
                                type=type,
                                occurredAt=txDate.atTime(12,0).atZone(zone).toInstant().toEpochMilli(),
                                reason=reason.trim().ifBlank{if(type==TransactionType.EXPENSE)"هزینه" else "درآمد"},
                                accountId=accountId,
                                categoryId=categoryId,
                                personId=personId,
                                note=note.trim()
                            )
                        )
                    },
                    enabled=Money.parse(amount)>0,
                    modifier=Modifier.fillMaxWidth().height(52.dp),
                    shape=RoundedCornerShape(18.dp)
                ){Text("ذخیره تغییرات",fontWeight=FontWeight.Bold)}
            }
        }
    }
}

